# Copy this file to .env and fill in your own values.
# Never commit real credentials. A live MongoDB Atlas URI was previously
# checked in here; that password is in git history and must be rotated
# in Atlas even if you still use that cluster.

# Database (MongoDB)
# Local development:
# DATABASE_URL=mongodb://localhost:27017/shadow
# MongoDB Atlas (cloud):
DATABASE_URL=mongodb+srv://USER:PASSWORD@HOST/shadow?retryWrites=true&w=majority

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
SOLANA_KEYPAIR_PATH=./id.json

# Optional: override on-chain program IDs (must be valid base58 pubkeys).
# Defaults match programs/shadow-registry and programs/shadow-profiles.
# SHADOW_REGISTRY_PROGRAM_ID=
# SHADOW_PROFILES_PROGRAM_ID=

# Privy - Get from https://dashboard.privy.io/
# Used for Google login that creates a Solana wallet
# Create an app at https://dashboard.privy.io/ and get your App ID
PRIVY_APP_ID=your_privy_app_id_here

# Pinata (IPFS) - Get from https://www.pinata.cloud/
# Used to upload and store files on IPFS (decentralized storage)
PINATA_API_KEY=your_pinata_api_key
# PINATA_SECRET and PINATA_SECRET_KEY are both accepted.
PINATA_SECRET=your_pinata_secret_key

# Bundlr (Arweave) - Get from https://bundlr.network/
# Used to upload and store files on Arweave (permanent storage)
BUNDLR_NODE_URL=https://devnet.bundlr.network
BUNDLR_PRIVATE_KEY=your_bundlr_private_key

# AWS S3 (Optional fallback storage)
# Only needed if you want to use S3 as a backup storage option
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# Server Configuration
PORT=8080                    # Backend server port
RUST_LOG=info                # Logging level (debug, info, warn, error)

# Frontend (Next.js public vars - these are exposed to the browser)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_WS_URL=wss://api.devnet.solana.com
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here
