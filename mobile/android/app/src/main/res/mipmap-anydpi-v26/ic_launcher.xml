<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive icon. Android composites the foreground over the background and
  then applies whatever mask the launcher uses — circle, squircle, teardrop —
  so the mark has to survive being cut to any of them. It is drawn at half the
  108dp canvas, well inside the 72dp safe zone, which is why it is smaller here
  than in the legacy square below it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
