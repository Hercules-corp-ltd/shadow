<?xml version="1.0" encoding="utf-8"?>
<!-- Shadow has one theme, and it is black. The stock template painted this
     white whenever the phone's dark mode was off, so a cold start on a
     light-mode phone flashed a white screen with the icon on it before the
     app's first frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/black" />
</layer-list>
